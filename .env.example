# Copia este archivo a .env y completa tus valores.
# Nunca subas el archivo .env al repositorio.

# Clave de la API oficial de Anthropic (obligatoria para consultar a Claude).
ANTHROPIC_API_KEY=tu_api_key_aqui

# Modelo de Claude. Haiku 4.5 es rápido y económico para el chatbot RAG.
CLAUDE_MODEL=claude-haiku-4-5

# Modelo local de Sentence Transformers para embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Servidor
HOST=0.0.0.0
PORT=8000

# PostgreSQL del centro de ayuda (CRM / WhatsApp).
# 5433 es el contenedor Docker (docker compose up -d).
# 5432 lo usa el PostgreSQL nativo de Windows y rechaza al usuario rag.
DATABASE_URL=postgres://rag:rag@127.0.0.1:5433/rag_micomco?sslmode=disable

# Token Bearer de /api/crm y /api/admin. Si lo dejas vacío, el servidor genera uno en .env.
CRM_SECRET_TOKEN=

# Opcional. Tokens y temperatura de Claude (el servidor Rust también los lee).
# CLAUDE_MAX_TOKENS=1200
# CLAUDE_TEMPERATURE=0.2

# Colección de ChromaDB. Por defecto: empresa_knowledge_base
# CHROMA_COLLECTION_NAME=empresa_knowledge_base

# Si CHROMA_HOST está definido, el backend Rust usa la API REST v2 de ChromaDB.
# Si se deja vacío, los embeddings se guardan en chroma_db/ (SQLite local).
# CHROMA_HOST=http://127.0.0.1:8001
# CHROMA_TOKEN=
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database
