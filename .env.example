# Copia este archivo a .env y completa tus valores.
# Nunca subas el archivo .env al repositorio.

# Clave de la API oficial de Anthropic (obligatoria para consultar a Claude).
ANTHROPIC_API_KEY=tu_api_key_aqui

# Modelo de Claude. Haiku 4.5 es rápido y económico para el chatbot RAG.
CLAUDE_MODEL=claude-haiku-4-5

# Modelo local de Sentence Transformers para embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Servidor
HOST=0.0.0.0
PORT=8000
